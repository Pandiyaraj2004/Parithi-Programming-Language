# "break" only ever exits its own loop — it never returns from the
# enclosing function. "return" is a distinct, separate control-flow
# operation that DOES exit the function even from inside a loop.

task findFirstEven(numbers)
    hold i = 0

    loop
        if i >= len(numbers)
            break
        end if

        if numbers[i] % 2 == 0
            return numbers[i]
        end if

        i = i + 1
    end loop

    return empty
end task

say findFirstEven(box(1, 3, 5, 8, 9))
say findFirstEven(box(1, 3, 5))
